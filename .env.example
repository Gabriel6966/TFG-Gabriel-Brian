# Copia este archivo como `.env` y rellena los valores reales.
# Vite expone solo las variables que empiezan por `VITE_` al cliente.
# Aviso: estas variables viajan en el bundle del navegador — el `.env`
# protege el repo, no el cliente. Hay que hardenear cada servicio por su panel
# (ver CLAUDE.md → Seguridad).

# ── Firebase ──────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check (opcional, vacío = no se activa).
# Crear siteKey en Firebase Console → App Check → reCAPTCHA v3.
VITE_RECAPTCHA_SITE_KEY=

# ── Cloudinary ────────────────────────────────────────────
# El preset debe estar configurado como UNSIGNED en el panel de Cloudinary
# con folder/formato/tamaño restringidos.
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=

# ── EmailJS ───────────────────────────────────────────────
# Activar whitelist de dominios en su panel para evitar uso desde otros sitios.
VITE_EMAILJS_SERVICE_ID=
# Plantilla para el código de invitación de empleados.
VITE_EMAILJS_TEMPLATE_ID=
# Plantilla para la confirmación de reserva al cliente.
VITE_EMAILJS_TEMPLATE_RESERVA_ID=
VITE_EMAILJS_PUBLIC_KEY=
