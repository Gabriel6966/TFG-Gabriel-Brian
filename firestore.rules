rules_version = '2';

// EasyOrder — Reglas de seguridad multitenant
//
// Modelo:
//   /usuarios/{uid}              → perfil del usuario (rol, localId, activo)
//   /invitaciones/{id}           → códigos de alta de empleados
//   /locales/{localId}/...       → datos del negocio (mesas, productos, comandas, facturas, etc.)
//
// Principios:
//   - Un usuario solo accede a documentos cuyo `localId` coincide con el suyo.
//   - Las acciones de escritura están restringidas por rol (admin / camarero / cocinero).
//   - Usuarios desactivados (`activo == false`) quedan bloqueados.
//
// Modelo de invitaciones: el código de 8 caracteres es el ID del documento.
// Esto permite que /register haga `get` por ID sin necesidad de `list`, evitando
// la enumeración. Solo el admin del local puede hacer `list` (con filtro localId).

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ─────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    // Devuelve el doc del perfil del usuario actual. Si no existe, falla la regla
    // (es exactamente lo que queremos: un usuario sin perfil no puede operar).
    function myProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isActive() {
      return isSignedIn() && myProfile().activo == true;
    }

    function hasRole(role) {
      return isActive() && myProfile().rol == role;
    }

    function isAdmin()    { return hasRole('admin'); }
    function isCamarero() { return hasRole('camarero'); }
    function isCocinero() { return hasRole('cocinero'); }

    function isStaff() {
      return isActive() && myProfile().rol in ['admin', 'camarero', 'cocinero'];
    }

    function sameLocal(localId) {
      return isActive() && myProfile().localId == localId;
    }

    // El perfil y la invitación se escriben en un único batch durante el alta.
    // get() comprueba que la invitación era válida y getAfter() que se consume
    // para el mismo usuario dentro de esa operación atómica.
    function validRegistration(profile) {
      return profile.invitacionId is string
             && exists(/databases/$(database)/documents/invitaciones/$(profile.invitacionId))
             && get(/databases/$(database)/documents/invitaciones/$(profile.invitacionId)).data.estado == 'pendiente'
             && profile.email == get(/databases/$(database)/documents/invitaciones/$(profile.invitacionId)).data.email
             && profile.rol == get(/databases/$(database)/documents/invitaciones/$(profile.invitacionId)).data.rol
             && profile.localId == get(/databases/$(database)/documents/invitaciones/$(profile.invitacionId)).data.localId
             && getAfter(/databases/$(database)/documents/invitaciones/$(profile.invitacionId)).data.estado == 'usada'
             && getAfter(/databases/$(database)/documents/invitaciones/$(profile.invitacionId)).data.usadoPor == request.auth.uid;
    }

    // Las acciones del camarero sobre una comanda se limitan al servicio y al
    // cobro. El contenido, importes y datos de la mesa permanecen inmutables.
    function waiterCanUpdateComanda() {
      return isCamarero()
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['estado', 'lineasEntregadas'])
             && (
               // Marcar líneas entregadas sin alterar el flujo de la comanda.
               (request.resource.data.estado == resource.data.estado
                && resource.data.estado in ['en_cocina', 'listo', 'para_camarero'])
               // Entregar solo comandas pendientes de servicio.
               || (request.resource.data.estado == 'entregado'
                   && resource.data.estado in ['listo', 'para_camarero'])
               // Cobrar solo una comanda existente del flujo operativo.
               || (request.resource.data.estado == 'pagado'
                   && resource.data.estado in ['en_cocina', 'listo', 'para_camarero', 'entregado'])
             );
    }

    // Cocina solo puede cambiar el avance de las líneas que debe preparar.
    function cookCanUpdateComanda() {
      return isCocinero()
             && resource.data.destino == 'cocina'
             && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['estado', 'estadoLineas'])
             && resource.data.estado in ['en_cocina', 'listo']
             && request.resource.data.estado in ['en_cocina', 'listo'];
    }

    // ── USUARIOS ────────────────────────────────────────────────
    match /usuarios/{uid} {
      // El propio usuario siempre puede leer su perfil (necesario para login
      // y para el listener inicial de auth en useAuth.ts).
      // Un admin puede leer/listar los empleados de su propio local.
      allow get:  if isSignedIn() && (
                    request.auth.uid == uid
                    || (isAdmin() && resource.data.localId == myProfile().localId)
                  );
      // Para `list`, la regla se evalúa por documento devuelto: solo se entregan
      // los del mismo local del admin. La query del cliente debe filtrar por
      // localId para que coincida; ver AdminView.vue.
      allow list: if isAdmin() && resource.data.localId == myProfile().localId;

      // Registro: el propio usuario crea su doc tras `createUserWithEmailAndPassword`.
      // Validamos campos críticos para evitar que un usuario se auto-asigne admin
      // o se vincule a otro local sin invitación.
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly([
                         'nombre', 'email', 'rol', 'localId', 'activo', 'creadoEn', 'invitacionId'
                       ])
                    && request.resource.data.activo == true
                    && request.resource.data.rol in ['admin', 'camarero', 'cocinero']
                    && request.resource.data.localId is string
                    && request.resource.data.email is string
                    && request.resource.data.nombre is string
                    && validRegistration(request.resource.data);

      // Actualización: el propio usuario solo puede cambiar su nombre.
      // Un admin del mismo local puede cambiar `activo` y `rol`.
      allow update: if (
                      isSignedIn()
                      && request.auth.uid == uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['nombre'])
                    ) || (
                      isAdmin()
                      && resource.data.localId == myProfile().localId
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['activo', 'rol'])
                      && request.resource.data.rol in ['admin', 'camarero', 'cocinero']
                    );

      // Borrado: solo admin del mismo local, y nunca a sí mismo.
      allow delete: if isAdmin()
                    && resource.data.localId == myProfile().localId
                    && uid != request.auth.uid;
    }

    // ── INVITACIONES ────────────────────────────────────────────
    // El código de invitación se usa como ID del documento. /register hace
    // `get` por ID con el código que escribe el empleado — no necesita `list`.
    match /invitaciones/{invId} {
      // Lectura pública solo por ID exacto (get) y solo si está pendiente.
      // `list` queda cerrado a no-admins, lo que cierra la enumeración.
      allow get: if resource.data.estado == 'pendiente';

      // El admin del mismo local puede leer todo (incluidas usadas).
      allow get, list: if isAdmin()
                       && resource.data.localId == myProfile().localId;

      // Crear: solo admin, para su propio local, y siempre en estado 'pendiente'.
      allow create: if isAdmin()
                    && request.resource.data.localId == myProfile().localId
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.rol in ['admin', 'camarero', 'cocinero']
                    && request.resource.data.codigo is string
                    && invId == request.resource.data.codigo
                    && request.resource.data.codigo.matches('^[A-Z0-9]{8}$')
                    && request.resource.data.email is string;

      // Marcar como usada durante el registro (puede no haber sesión aún:
      // /register actualiza la invitación justo después del createUser, en ese
      // momento ya hay auth.uid pero no /usuarios/{uid}).
      // Solo permitimos la transición pendiente→usada y campos concretos.
      allow update: if isSignedIn()
                    && resource.data.estado == 'pendiente'
                    && request.resource.data.estado == 'usada'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['estado', 'usadoPor', 'usadoEn'])
                    && request.resource.data.usadoPor == request.auth.uid
                    && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.invitacionId == invId
                    && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.email == resource.data.email
                    && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == resource.data.rol
                    && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.localId == resource.data.localId
                    && getAfter(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo == true;

      // Borrar: admin del mismo local.
      allow delete: if isAdmin()
                    && resource.data.localId == myProfile().localId;
    }

    // ── DATOS DEL NEGOCIO (/locales/{localId}/...) ──────────────
    match /locales/{localId} {

      // Config del negocio (nombre, logo, color)
      match /config/{configId} {
        allow read:  if isStaff() && sameLocal(localId);
        allow write: if isAdmin() && sameLocal(localId);
      }

      // Mesas: el camarero puede reflejar exclusivamente el estado de servicio.
      // La posición, capacidad y demás configuración pertenecen al administrador.
      match /mesas/{mesaId} {
        allow read:           if isStaff() && sameLocal(localId);
        allow update: if sameLocal(localId) && (
                        isAdmin()
                        || (isCamarero()
                            && request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['estado'])
                            && request.resource.data.estado in ['libre', 'ocupada', 'preparando'])
                      );
        allow create, delete: if isAdmin() && sameLocal(localId);
      }

      // Productos: lectura para todos, escritura solo admin.
      match /productos/{prodId} {
        allow read: if isStaff() && sameLocal(localId);
        allow create, delete: if isAdmin() && sameLocal(localId);
        // El camarero solo descuenta stock al registrar un pedido. Cocina no
        // necesita escribir inventario y ningún rol operativo puede editar el menú.
        allow update: if sameLocal(localId) && (
                        isAdmin()
                        || (isCamarero()
                            && request.resource.data.diff(resource.data)
                                 .affectedKeys().hasOnly(['stock'])
                            && request.resource.data.stock is number
                            && request.resource.data.stock >= 0)
                      );
      }

      // Categorías
      match /categorias/{catId} {
        allow read:  if isStaff() && sameLocal(localId);
        allow write: if isAdmin() && sameLocal(localId);
      }

      // Zonas de la sala
      match /zonas/{zonaId} {
        allow read:  if isStaff() && sameLocal(localId);
        allow write: if isAdmin() && sameLocal(localId);
      }

      // Elementos decorativos del mapa (FloorEditor / PosFloorMap)
      match /elementosDecor/{elemId} {
        allow read:  if isStaff() && sameLocal(localId);
        allow write: if isAdmin() && sameLocal(localId);
      }

      // Comandas: al crearlas se vinculan a su autor y a una mesa real del local.
      // Cada rol solo puede modificar los campos necesarios para su flujo.
      match /comandas/{comandaId} {
        allow read:   if isStaff() && sameLocal(localId);
        allow create: if (isAdmin() || isCamarero())
                      && sameLocal(localId)
                      && request.resource.data.usuarioId == request.auth.uid
                      && request.resource.data.mesaId is string
                      && exists(/databases/$(database)/documents/locales/$(localId)/mesas/$(request.resource.data.mesaId))
                      && request.resource.data.destino in ['cocina', 'camarero']
                      && (
                        (request.resource.data.destino == 'cocina'
                         && request.resource.data.estado == 'en_cocina')
                        || (request.resource.data.destino == 'camarero'
                            && request.resource.data.estado == 'para_camarero')
                      );
        allow update: if sameLocal(localId) && (
                        isAdmin()
                        || waiterCanUpdateComanda()
                        || cookCanUpdateComanda()
                      );
        allow delete: if isAdmin() && sameLocal(localId);
      }

      // Facturas: se atribuyen al usuario que las crea y a una mesa existente.
      // Solo administración puede rectificar o eliminar el historial de caja.
      match /facturas/{facturaId} {
        allow read:           if isStaff() && sameLocal(localId);
        allow create: if (isAdmin() || isCamarero())
                      && sameLocal(localId)
                      && request.resource.data.usuarioId == request.auth.uid
                      && request.resource.data.mesaId is string
                      && exists(/databases/$(database)/documents/locales/$(localId)/mesas/$(request.resource.data.mesaId))
                      && request.resource.data.metodoPago in ['efectivo', 'tarjeta']
                      && request.resource.data.total is number
                      && request.resource.data.total >= 0;
        allow update, delete: if isAdmin() && sameLocal(localId);
      }
      
      // Reservas: camarero y admin pueden crearlas; el camarero solo gestiona
      // su estado. Cocina no accede a datos personales de clientes.
      match /reservas/{reservaId} {
        allow read:   if isStaff() && sameLocal(localId);
        allow create: if (isAdmin() || isCamarero())
                      && sameLocal(localId)
                      && request.resource.data.estado == 'pendiente'
                      && request.resource.data.nombre is string
                      && request.resource.data.personas is number
                      && request.resource.data.personas > 0
                      && request.resource.data.mesaId is string;
        allow update: if sameLocal(localId) && (
                        isAdmin()
                        || (isCamarero()
                            && request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['estado'])
                            && request.resource.data.estado in [
                                 'pendiente', 'confirmada', 'cancelada', 'cumplida'
                               ])
                      );
        allow delete: if isAdmin() && sameLocal(localId);
      }
    }

    // Bloqueo explícito: cualquier ruta no contemplada queda denegada.
    // Esto cubre las colecciones raíz "productos" y "pedidos" usadas por las
    // vistas legacy MenuView/CheckoutView (ver bug #8 del informe).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
